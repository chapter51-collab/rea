{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build:cached)",
      "Bash(npm run test:local:*)",
      "Bash(npm run test:focused:*)",
      "Bash(npm run check:fast)",
      "Bash(npm run docs:check)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run lint:details)",
      "Bash(npm run lint:fix)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(npm publish:*)", "Bash(rea setup:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
